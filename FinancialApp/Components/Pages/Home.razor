@page "/"

<div class="center-container">
    <div class="card">
        <h2>Annuity Calculator</h2>

        <EditForm EditContext="@EditContext" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-row">
                <label for="amount">Initial Amount</label>
                <InputNumber id="amount" @bind-Value="Model.Amount" class="input" step="0.01" />
            </div>

            <div class="form-row">
                <label for="deposit">Deposit</label>
                <InputNumber id="deposit" @bind-Value="Model.Deposit" class="input" step="0.01" />
            </div>

            <div class="form-row">
                <label for="rate">Annual interest rate</label>
                <InputNumber id="rate" @bind-Value="Model.AnnualInterestRate" class="input" step="0.01" />
            </div>

            <div class="form-row">
                <label for="period">Period</label>
                <InputNumber id="period" @bind-Value="Model.Period" class="input" />
                <small class="help-text">Period must be in months</small>
            </div>

            <div class="form-row">
                <button type="button" class="add-deposit-btn" @onclick="AddAdditionalDeposit" title="Add additional deposit" aria-label="Add additional deposit">
                    <!-- plus icon -->
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>

            @if (AdditionalDeposits?.Count > 0)
            {
                <div class="additional-deposits">
                    @for (int i = 0; i < AdditionalDeposits.Count; i++)
                    {
                        var ad = AdditionalDeposits[i];
                        var idx = i; // capture loop index in a local variable to avoid closure capturing the loop variable
                        <div class="additional-deposit-box" @key=@($"newDepositBox{idx}")>
                            <button type="button" class="delete-btn" title="Remove deposit" @onclick="() => RemoveAdditionalDeposit(idx)" aria-label="Remove additional deposit">
                                <!-- trash icon (inline SVG) -->
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                            <div class="form-row" @key=@($"newDeposit{i}")>
                                <label for=@($"newDeposit{i}")>New Deposit @(i+1)</label>
                                <InputNumber id=@($"newDeposit{i}") @bind-Value="ad.Amount" class="input" step="0.01" />
                            </div>
                            <div class="form-row" @key=@($"newPeriod{i}")>
                                <label for=@($"newPeriod{i}")>New period @(i+1)</label>
                                <InputNumber id=@($"newPeriod{i}") @bind-Value="ad.Period" class="input" />
                            </div>
                        </div>
                    }
                </div>
            }

            <button type="submit" class="btn">Calculate</button>
        </EditForm>
        
        @if (FutureValue != 0m)
        {
            <div id="result-box">
                <p>Future Value:</p><p>@($"{FutureValue:C}")</p>
                @if (AdditionalDepositsTotal != 0m)
                {
                    <p>Additional Value:</p><p>@($"{AdditionalDepositsTotal:C}")</p>
                    <p>Total Value:</p><p>@($"{(FutureValue + AdditionalDepositsTotal):C}")</p>
                }
            </div>
        }
    </div>
</div>


