
@page "/add-transaction"

<h3>Add Transaction</h3>

<div class="my-3 card">
    <div class="card-body">
        <div class="mb-3">
            <label for="transactionDescription">Transaction description</label>
            <textarea id="transactionDescription" class="form-control" rows="4" value="@TransactionDescription" @oninput="@(e => OnTransactionDescriptionChanged(e))" maxlength="200"></textarea>
        </div>

        <div class="mb-2">
            <button class="btn btn-sm btn-outline-primary" @onclick="AddTransactionLine">+ Add Transaction line</button>
        </div>

        @if (TransactionLines?.Any() == true)
        {
            foreach (var line in TransactionLines)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="mb-2 d-flex justify-content-end">
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveTransactionLine(line)">Remove</button>
                        </div>

                        <div class="field-with-popover mb-2">
                            <div class="label-with-icon d-flex align-items-center mb-1">
                                <label for="parentSelect" class="mb-0">Select an account</label>
                                @if (line.SelectedParentId.HasValue)
                                {
                                    <div class="info-container ms-2">
                                        <button class="info-icon" @onclick="() => ToggleParentPopover(line)">i</button>
                                        @if (line.IsParentPopoverVisible)
                                        {
                                            <div class="popover-overlay">
                                                <div class="card p-2">
                                                    <div class="small">@GetParentDescription(line)</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <select class="form-select" @onchange="@(e => OnParentChangedForLine(e, line))" value="@(line.SelectedParentId?.ToString() ?? String.Empty)">
                                <option value="">-- Select --</option>
                                @if (ParentAccounts is not null)
                                {
                                    foreach (var acct in ParentAccounts)
                                    {
                                        <option value="@acct.Id">@acct.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="field-with-popover mb-2">
                            <div class="label-with-icon d-flex align-items-center mb-1">
                                <label for="childSelect" class="mb-0">Select a sub-account</label>
                                @if (line.SelectedChildId.HasValue)
                                {
                                    <div class="info-container ms-2">
                                        <button class="info-icon" @onclick="() => ToggleChildPopover(line)">i</button>
                                        @if (line.IsChildPopoverVisible)
                                        {
                                            <div class="popover-overlay">
                                                <div class="card p-2">
                                                    <div class="small">@GetChildDescription(line)</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <select class="form-select" value="@(line.SelectedChildId?.ToString() ?? String.Empty)" @onchange="@(e => OnChildChangedForLine(e, line))">
                                <option value="">-- Select --</option>
                                @if (line.ChildAccounts is not null)
                                {
                                    foreach (var acct in line.ChildAccounts)
                                    {
                                        <option value="@acct.Id">@acct.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <label>Description</label>
                        <textarea class="form-control mb-2" maxlength="200" rows="2" value="@line.Description" @oninput="@(e => OnLineDescriptionChanged(e, line))"></textarea>

                        <label>Amount</label>
                        <input class="form-control" type="number" step="0.01" min="0.01" value="@line.Amount" @oninput="@(e => OnLineAmountChanged(e, line))" />
                    </div>
                </div>
            }
        }

        <div class="my-3">
            <button class="btn btn-primary" @onclick="CreateTransaction">Submit</button>
        </div>

        @if (ShowValidation && !CanSubmit)
        {
            <div class="mt-2 text-danger">
                <ul>
                    @foreach (var err in GetValidationErrors())
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

    </div>
</div>

