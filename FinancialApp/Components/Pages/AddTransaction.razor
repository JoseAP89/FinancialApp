
@page "/add-transaction"

<h3>Add Transaction</h3>

<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <label for="transactionDescription">Transaction description</label>
            <textarea id="transactionDescription" class="form-control" rows="4" value="@TransactionDescription" @oninput="@(e => OnTransactionDescriptionChanged(e))" maxlength="200"></textarea>
        </div>

        <div class="mb-2">
            <button class="btn btn-sm btn-outline-primary" @onclick="AddTransactionLine">+ Add Transaction line</button>
        </div>

        @if (TransactionLines?.Any() == true)
        {
            foreach (var line in TransactionLines)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="mb-2 d-flex justify-content-end">
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveTransactionLine(line)">Remove</button>
                        </div>

                        <label for="parentSelect">Select an account</label>
                        <select class="form-select mb-2" @onchange="@(e => OnParentChangedForLine(e, line))" value="@(line.SelectedParentId?.ToString() ?? String.Empty)">
                            <option value="">-- Select --</option>
                            @if (ParentAccounts is not null)
                            {
                                foreach (var acct in ParentAccounts)
                                {
                                    <option value="@acct.Id">@acct.Name</option>
                                }
                            }
                        </select>

                        <label for="childSelect">Select a sub-account</label>
                        <select class="form-select mb-2" value="@(line.SelectedChildId?.ToString() ?? String.Empty)" @onchange="@(e => OnChildChangedForLine(e, line))">
                            <option value="">-- Select --</option>
                            @if (line.ChildAccounts is not null)
                            {
                                foreach (var acct in line.ChildAccounts)
                                {
                                    <option value="@acct.Id">@acct.Name</option>
                                }
                            }
                        </select>

                        <label>Description</label>
                        <textarea class="form-control mb-2" maxlength="200" rows="2" value="@line.Description" @oninput="@(e => OnLineDescriptionChanged(e, line))"></textarea>

                        <label>Amount</label>
                        <input class="form-control" type="number" step="0.01" min="0.01" value="@line.Amount" @oninput="@(e => OnLineAmountChanged(e, line))" />
                    </div>
                </div>
            }
        }

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="CreateTransaction">Submit</button>
        </div>

        @if (ShowValidation && !CanSubmit)
        {
            <div class="mt-2 text-danger">
                <ul>
                    @foreach (var err in GetValidationErrors())
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

    </div>
</div>

