
@page "/personal-finance"

<h3>Personal Finance</h3>

<div class="card">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }
        else if (IsLoading)
        {
            <div>Loading accounts...</div>
        }
        else
        {
            <label for="accountSelect">Select an account</label>
            <select id="accountSelect" @bind="SelectedParentId" class="form-select">
                <option value="">-- Select --</option>
                @if (ParentAccounts is not null)
                {
                    foreach (var acct in ParentAccounts)
                    {
                        <option value="@acct.Id">@acct.Name</option>
                    }
                }
            </select>
            <div class="mt-3">
                <label for="subAccountSelect">Select a sub-account</label>
                <select id="subAccountSelect" @bind="SelectedChildId" class="form-select">
                    <option value="">-- Select --</option>
                    @if (ChildAccounts is not null)
                    {
                        foreach (var acct in ChildAccounts)
                        {
                            <option value="@acct.Id">@acct.Name</option>
                        }
                    }
                </select>
            </div>
        }
    </div>
</div>

